# =============================================================================
# MDI — Environment template
# Copy to .env and fill in.  Never commit .env.
# =============================================================================

# ---- LLM ----
# Required at runtime; tests run offline against the FakeGateway.
# Multi-provider: configure either or both. The provider router (see
# src/mdi/kernel/provider_router.py) decides which provider serves which organ.

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# --- Anthropic Claude (optional, used when routing policy selects it) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_HAIKU=claude-haiku-4-5
CLAUDE_MODEL_SONNET=claude-sonnet-4-5
CLAUDE_MODEL_OPUS=claude-opus-4-1

# --- Defaults ---
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
# 'gemini' | 'anthropic' | 'auto' (auto = follow provider_router policy)
DEFAULT_PROVIDER=auto

# ---- Cost controls ----
# Daily global cap (USD).  Per-tenant ceilings live in the tenants table.
DAILY_SPEND_CAP_USD=5.00
COST_SOFT_WARN_PCT=0.80
COST_HARD_CAP_PCT=1.00

# ---- Database ----
DATABASE_URL=postgresql+psycopg://mdi:mdi@localhost:5432/mdi
DATABASE_URL_ASYNC=postgresql+asyncpg://mdi:mdi@localhost:5432/mdi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Redis / queue ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720

# ---- Embeddings ----
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
# False = deterministic stub (instant, identical-input-only memory hits)
# True  = real BAAI/bge-m3 (semantic similarity; ~2GB download + ~30s warm-up
#         on first use; required for the self-training loop to fire on real data)
USE_REAL_EMBEDDINGS=false

# ---- Observability (optional — no-op when blank) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Page-limit gate ----
PAGE_LIMIT_SOFT=10
PAGE_LIMIT_HARD=200

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ---- Pipeline tuning ----
ORGAN_CONCURRENCY=5
BATCH_TIMEOUT_SECONDS=900

# ---- Conscience safety ----
# Production should keep this OFF until analyst approves invented rules.
ENABLE_INVENTED_RULES=false
ENTITY_RESOLVER_THRESHOLD=85
